# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/database"

# Server Configuration
# PORT: Server port (default: 5000)
# HOST: Server host binding
#   - Use 0.0.0.0 for VPS/production (accepts external connections)
#   - Use localhost for local development (only local connections)
PORT=5000
HOST=0.0.0.0
BASE_URL="https://your-domain.com"

# Node Environment
# Set to 'production' for deployment, 'development' for local dev
NODE_ENV=production
LOG_LEVEL=info  # debug, info, warn, error

# Session Secret
# Generate a strong random string for production
# Example: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-string"

# AI Integration (Optional)
# Default provider: xAI / Grok
# Leave AI_API_KEY empty or set AI_ENABLED=false if not using AI features
AI_ENABLED=true
AI_PROVIDER="xai"
AI_BASE_URL="https://api.x.ai/v1"
# Base fallback model (used when task-specific model vars are not set)
AI_MODEL="grok-4-1-fast-reasoning"
# Recommended task-specific models
AI_MODEL_AGENT="grok-4-1-fast-reasoning"
AI_MODEL_SUMMARY="grok-4-1-fast-non-reasoning"
AI_API_KEY=""

# Legacy aliases supported by the app for backward compatibility:
# AI_INTEGRATIONS_OPENAI_API_KEY=""
# AI_INTEGRATIONS_OPENAI_BASE_URL="https://api.x.ai/v1"

# Google OAuth (Optional)
# Required only if you use "Login with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Security Configuration (Required for Production)
# JWT_SECRET: Secret key for signing JWT tokens (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# ENCRYPTION_KEY: 32-byte key for AES-256 encryption of API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-32-byte-encryption-key-as-64-hex-chars"

# Development Mode (Optional)
# Set SKIP_AUTH=true to disable authentication in development
# WARNING: Never use this in production!
# SKIP_AUTH=true
